{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs",
      "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && pnpm --filter @jeevan/web build",
      "bindings": [
        {
          "type": "service",
          "service": "astrology-api",
          "format": "url",
          "env": "ASTROLOGY_API_URL"
        }
      ]
    },
    "astrology-api": {
      "root": "apps/astrology-api/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
